PORT=3000

# Percent move on a 1-minute candle (open -> current/close) that triggers a highlight + Telegram alert
THRESHOLD_PERCENT_1M=2

# Percent move on a 5-minute candle that triggers a highlight + Telegram alert
THRESHOLD_PERCENT_5M=5

# Percent move on a 15-minute candle that triggers a highlight + Telegram alert
THRESHOLD_PERCENT_15M=8

# Create a bot with @BotFather on Telegram, paste the token it gives you here
TELEGRAM_BOT_TOKEN=

# Numeric chat id to send alerts to (see README instructions to find yours)
TELEGRAM_CHAT_ID=
